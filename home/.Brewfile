# Taps
tap "homebrew/bundle"
tap "homebrew/cask-fonts"

# Terminal
brew "zsh"
brew "tmux"

# Development
brew "git"
brew "git-delta"
brew "gh"
brew "mas"
brew "nvm"
brew "pnpm"

# Neovim
brew "neovim"
brew "ripgrep"
brew "fd"
brew "lazygit"

# AI
cask "claude-code"

# Fonts (for Powerlevel10k and iTerm2)
cask "font-meslo-lg-nerd-font"

# Apps (iTerm2, 1Password는 install.sh에서 먼저 설치됨)
cask "cursor"
cask "karabiner-elements"
cask "raycast"  # TODO: Required initial setup
cask "readdle-spark"
cask "obsidian"
cask "arc"
cask "keka"
cask "aldente"
cask "appcleaner"

# Mac App Store
mas "KakaoTalk", id: 869223134
mas "RunCat", id: 1429033973
mas "Folder Hub", id: 6473019059
